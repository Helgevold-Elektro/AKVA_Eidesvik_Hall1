Position:=0;&#xD;
&#xD;
FOR Index:=0 TO LEN(Inp_TextString) DO&#xD;
	&#xD;
	Position:=0;&#xD;
	Position:=FIND(Inp_TextString, Inp_ReplaceFrom);&#xD;
	&#xD;
	IF Position &gt; 0 THEN &#xD;
		Inp_TextString:=REPLACE(Inp_TextString, Inp_ReplaceTo, LEN(Inp_ReplaceFrom), Index);&#xD;
	END_IF;&#xD;
&#xD;
END_FOR;</Text></StructuredTextModel>