                          <Entity type="FunctionBlock" subtype="StructuredText" id="a97360c8-c63a-4d1d-9b6d-72673ac4d584" name="HE_SMSNotification" version="0" dateCreated="04/19/2023 08:07:22" dateLastModified="02/25/2025 15:32:48" label="6.0.2" author="Daniel Årvik" comment="For use with Omron RT100. Sends SMS alarms, emergency messages, and handles acknowledgments. Supports SCADA alarm and shift settings, as well as reconnection in case of communication failure. Provides access to incoming SMS for use in other functions and has separate outputs for sirens and warning lights. Also retrieves signal strength and IMEI from RT100 (does not apply to slave)." usingNamespaces="OEN\nEth\nSMS&#xD;&#xA;" trackingId="f14758fd-2983-4f0d-8591-41fcac5eb9d4" DN="HE_SMSNotification">
