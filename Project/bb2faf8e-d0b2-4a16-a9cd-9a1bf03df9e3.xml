<StructuredTextModel xmlns="http://schemas.datacontract.org/2004/07/Omron.Cxap.Modules.StructuredText.Core" xmlns:i="http://www.w3.org/2001/XMLSchema-instance"><Text>//-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xD;
//	NAME:						HE_DiffCheck&#xD;
//	CREATOR:					Helgevold - Daniel Årvik&#xD;
// REQUIREMENTS: 		NX CPU&#xD;
// &#xD;
//-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------&#xD;
//  VERSION LOG:&#xD;
//	VERSION			DATE						SIGN							DESCRIPTION&#xD;
//	1.0.0					2023-02-24				Daniel Årvik					Initial Release&#xD;
//	2.0.0					2025-03-25				William Veim				Rework&#xD;
//	2.1.0					2025-10-16				William Veim				Rework logic and translate&#xD;
//================================================================================================================================&#xD;
//&#xD;
//		DESCRIPTION:&#xD;
//		Value fault based on change in value. &#xD;
//		If value exceeds thershold (min or max) whitin a set time&#xD;
//		&#xD;
//===============================================================================================================================&#xD;
&#xD;
(*************************************************************************&#xD;
 *	VARIABLE CONTROL&#xD;
 *************************************************************************)&#xD;
IF P_First_Run THEN&#xD;
	Value_Sample:=Inp_Value;&#xD;
END_IF;&#xD;
&#xD;
Min_DiffValue:=Value_Sample - Inp_MaxValue*Cfg_ValueStuck_Deviation/100;&#xD;
Max_DiffValue:=Value_Sample + Inp_MaxValue*Cfg_ValueStuck_Deviation/100;&#xD;
&#xD;
(*************************************************************************&#xD;
 *	LOGIC AND TIMERS&#xD;
 *************************************************************************)&#xD;
 &#xD;
 TON_ValueStuck(PT:=Cfg_ValueStuck_Delay);&#xD;
 &#xD;
 IF Inp_Value &gt;= HE_ABSValue(Max_DiffValue - Min_DiffValue) AND Inp_Value &lt;= HE_ABSValue(Max_DiffValue - Min_DiffValue) THEN&#xD;
	TON_ValueStuck.In:=TRUE;&#xD;
 ELSE&#xD;
	TON_ValueStuck.In:=FALSE;&#xD;
	Value_Sample:=Inp_Value;&#xD;
END_IF;&#xD;
&#xD;
(*************************************************************************&#xD;
 *	UPDATING OUTPUTS&#xD;
 *************************************************************************)&#xD;
 &#xD;
Out_ValueStuck:=TON_ValueStuck.Q;</Text></StructuredTextModel>